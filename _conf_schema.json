{
  "provider_id": {
    "type": "string",
    "description": "LLM模型",
    "hint": "选择provider",
    "_special": "select_provider",
    "default": ""
  },
  "schedule_time": {
    "type": "string",
    "description": "每日推送时间",
    "hint": "HH:MM格式上海时区留空禁用",
    "default": "08:00"
  },
  "max_report_items": {
    "type": "int",
    "description": "送入 LLM 的最大候选条目数",
    "hint": "建议 30，LLM 会从中选出 科技热点 6~8 条、AI动态 6~8 条、GitHub Trending 10 条。",
    "default": 30
  },
  "enable_pushplus": {
    "type": "bool",
    "description": "同时通过PushPlus推送",
    "default": false
  },
  "pushplus_token": {
    "type": "string",
    "description": "PushPlus Token",
    "default": ""
  },
  "pushplus_channel": {
    "type": "string",
    "description": "PushPlus渠道",
    "default": "clawbot"
  }
}
